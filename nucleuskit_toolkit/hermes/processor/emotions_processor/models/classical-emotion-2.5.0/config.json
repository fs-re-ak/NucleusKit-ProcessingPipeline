{
  "dataset_dir": "dataset",
  "labels": [
    "NEUTRAL",
    "HAPPINESS",
    "ANGER",
    "DISGUST",
    "FEAR",
    "SURPRISE",
    "SADNESS",
    "CONTEMPT_LEFT",
    "CONTEMPT_RIGHT"
  ],
  "classifier": "logistic_regression",
  "scale_features": true,
  "seed": 42,
  "classifier_params": {
    "C": 1.0,
    "max_iter": 1000,
    "solver": "lbfgs"
  },
  "split_strategy": "loso",
  "split_train": 0.7,
  "split_val": 0.15,
  "split_test": 0.15,
  "probe_degraded_channels": false,
  "feature_set": "extended_nm_a",
  "require_label_match": true,
  "use_instruction_label": true,
  "input_channels": [
    "Supraorbital_L",
    "Supraorbital_R",
    "Zygomatic_L",
    "Zygomatic_R",
    "Temporal_EEG",
    "Glabella",
    "Temporal_R",
    "Nasolabial"
  ],
  "drop_channels": [],
  "label_map": {},
  "sample_rate_hz": 250,
  "window_samples": 500,
  "architecture": "flat",
  "exclude_subjects": [],
  "apply_nlms": false,
  "merge_contempt": true
}